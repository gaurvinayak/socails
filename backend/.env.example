# MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=socails

# Server URLs (must match what you register as redirect URIs in each platform's developer portal)
BACKEND_URL=http://localhost:8002
FRONTEND_URL=http://localhost:3001

# Meta App (used for BOTH Instagram and Facebook)
# Register these redirect URIs in Meta for Developers:
#   http://localhost:8002/api/auth/instagram/callback
#   http://localhost:8002/api/auth/facebook/callback
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# X (Twitter) — OAuth 2.0 with PKCE
# Register this redirect URI in Twitter Developer Portal:
#   http://localhost:8002/api/auth/twitter/callback
TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret

# LinkedIn — OAuth 2.0
# Register this redirect URI in LinkedIn Developer Portal:
#   http://localhost:8002/api/auth/linkedin/callback
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# Anthropic (used for AI caption generation + inbox auto-tagging)
ANTHROPIC_API_KEY=your_anthropic_api_key
